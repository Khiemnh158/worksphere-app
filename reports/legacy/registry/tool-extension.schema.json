{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkSphereToolAndExtensionRecord",
  "description": "Schema for tracked tools, applications, and IDE extensions evaluated for WorkSphere.",
  "type": "object",
  "required": [
    "registryId",
    "category",
    "productName",
    "publisher",
    "officialDownloadUrl",
    "version",
    "license",
    "installType",
    "executableOrVsixPath",
    "adminRequired",
    "status",
    "lastVerifiedDate"
  ],
  "properties": {
    "registryId": {
      "type": "string",
      "pattern": "^TOOL-EXT-[0-9]{3,}$"
    },
    "category": {
      "type": "string",
      "enum": ["tool", "application", "cli", "extension", "driver"]
    },
    "productName": {
      "type": "string"
    },
    "extensionId": {
      "type": "string",
      "description": "Unique VS Code / Antigravity extension ID (e.g., publisher.name)"
    },
    "publisher": {
      "type": "string"
    },
    "officialDownloadUrl": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string"
    },
    "installType": {
      "type": "string",
      "enum": ["portable", "installer", "winget", "marketplace", "package_manager", "builtin"]
    },
    "sha256Checksum": {
      "type": "string"
    },
    "authenticodeSignature": {
      "type": "string",
      "enum": ["VALID_OFFICIAL", "UNSIGNED", "SELF_SIGNED", "NOT_APPLICABLE"]
    },
    "executableOrVsixPath": {
      "type": "string"
    },
    "dataPath": {
      "type": "string"
    },
    "cachePath": {
      "type": "string"
    },
    "configPath": {
      "type": "string"
    },
    "logPath": {
      "type": "string"
    },
    "adminRequired": {
      "type": "boolean"
    },
    "modifiesSystemPath": {
      "type": "boolean"
    },
    "backgroundServicesOrTasks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "networkEndpoints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "workspaceTrustRequired": {
      "type": "boolean"
    },
    "license": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "INSTALLED",
        "ENABLED",
        "ENABLED_FOR_WORKSPHERE",
        "APPROVED",
        "REQUIRED",
        "OPTIONAL",
        "DEPRECATED",
        "REJECTED",
        "QUARANTINED"
      ]
    },
    "verificationCommand": {
      "type": "string"
    },
    "uninstallCommandOrRecovery": {
      "type": "string"
    },
    "workSpherePurpose": {
      "type": "string"
    },
    "lastVerifiedDate": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  }
}
