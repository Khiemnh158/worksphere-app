name: WorkSphere CI

on:
  push:
    branches:
      - main
      - develop
  pull_request:
    branches:
      - main
      - develop

jobs:
  validate-repository:
    name: Validate Repository & Secret Audit
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Verify Canonical Documentation
        run: |
          echo "Checking canonical documents..."
          test -f docs/01_PROJECT_SCOPE.md
          test -f docs/02_USER_ROLES_AND_WORKFLOWS.md
          test -f docs/03_MOBILE_SCREEN_MAP.md
          test -f docs/04_SYSTEM_ARCHITECTURE.md
          test -f docs/05_DATABASE_DESIGN.md
          test -f docs/06_API_CONTRACT.md
          test -f docs/07_FOUR_COURSE_MATRIX.md
          test -f docs/08_DEVELOPMENT_ROADMAP.md
          test -f docs/09_CODING_STANDARDS.md
          test -f docs/10_AI_AGENT_INSTRUCTIONS.md
          echo "All 10 canonical documents exist."

      - name: Check for Accidentally Committed Secrets
        run: |
          echo "Scanning for forbidden secret files..."
          if find . -name "*.key" -o -name "*.pem" -o -name ".env" | grep -v "^./.env.example"; then
            echo "Error: Detected forbidden key or real .env file committed!"
            exit 1
          fi
          echo "Secret audit passed."

  backend-ci-skeleton:
    name: Backend CI Skeleton (Spring Boot)
    runs-on: ubuntu-latest
    needs: validate-repository
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '21'

      - name: Check Backend Directory
        run: |
          echo "Backend structure ready for Stage 2 initialization."
          test -d backend

  mobile-ci:
    name: Mobile Quality (React Native)
    runs-on: ubuntu-latest
    needs: validate-repository
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version-file: mobile/.node-version
          cache: npm
          cache-dependency-path: mobile/package-lock.json

      - name: Install mobile dependencies
        working-directory: mobile
        run: npm ci

      - name: Lint mobile code
        working-directory: mobile
        run: npm run lint

      - name: Typecheck mobile code
        working-directory: mobile
        run: npm run typecheck

      - name: Run mobile unit tests
        working-directory: mobile
        run: npm test -- --runInBand
