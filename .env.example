# WorkSphere - Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env for local development.

# ==================================================
# 1. APPLICATION & PROFILE
# ==================================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

# ==================================================
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ==================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=worksphere
DB_USER=worksphere_user
DB_PASSWORD=placeholder_local_db_password
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# ==================================================
# 3. SECURITY & JWT AUTHENTICATION
# ==================================================
# Secret key must be at least 256 bits (32 bytes)
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_placeholder_example_12345
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_EXPIRATION=2592000

# ==================================================
# 4. FILE STORAGE CONFIGURATION
# ==================================================
FILE_STORAGE_DIR=./uploads
FILE_MAX_SIZE_BYTES=20971520

# ==================================================
# 5. MOBILE API BASE URL
# ==================================================
# For Android Emulator, use 10.0.2.2 to access host machine:
MOBILE_API_BASE_URL=http://10.0.2.2:8080/api/v1
# For iOS Simulator:
# MOBILE_API_BASE_URL=http://localhost:8080/api/v1
